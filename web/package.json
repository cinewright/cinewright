{
  "name": "cinewright-web",
  "version": "0.0.0",
  "private": true,
  "description": "Cinewright web UI, built into src/cinewright/web_dist and served by the core.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "copy:components": "node scripts/copy-components.mjs",
    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run gen:tokens && npm run copy:components",
    "build": "tsc --noEmit && vite build",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "lucide-react": "1.70.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
